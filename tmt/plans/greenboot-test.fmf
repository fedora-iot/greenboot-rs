summary: Greenboot test plan
discover:
  how: fmf
  test: greenboot-test
execute:
  how: tmt
provision:
  hardware:
    virtualization:
      is-supported: true
    cpu:
      processors: ">= 4"
    memory: ">= 16 GB"
    disk:
      - size: ">= 40 GB"

/bootc-qcow2:
  summary: Test greenboot with bootc qcow2 image
  environment+:
    TEST_CASE: bootc-qcow2

/bootc-anaconda-iso:
  summary: Test greenboot with bootc anaconda iso
  environment+:
    TEST_CASE: bootc-anaconda-iso

/ostree-commit:
  summary: Test greenboot with ostree commit
  environment+:
    TEST_CASE: ostree-commit

/fedora-iot-raw:
  summary: Test greenboot with pre-built Fedora IoT raw image
  environment+:
    TEST_CASE: fedora-iot-raw

# This test should always run on current GA and rawhide
/legacy-trigger-compat:
  summary: Test backward compatibility for legacy rollback trigger (released ≤ v0.16.4 to current)
  environment+:
    TEST_CASE: legacy-trigger-compat

